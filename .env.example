# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Runtime environment. Use "production" only with all production safeguards
# enabled below; the default "development" keeps the local bootstrap usable.
JARVIS_ENV=development

# =============================================================================
# Model Provider Selection
# =============================================================================
# Supported: "ollama" (local), "gemini" (cloud). Default: ollama.
JARVIS_MODEL_PROVIDER=ollama

# =============================================================================
# Ollama Settings (Local LLM Inference)
# =============================================================================
OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=qwen2.5:1.5b

# =============================================================================
# Google Gemini Settings (Cloud)
# =============================================================================
# GEMINI_API_KEY=your-gemini-key-here
# JARVIS_MODEL=gemini-2.5-flash

# =============================================================================
# Voice (Tier 3) — Get free keys at the respective consoles
# https://console.deepgram.com  |  https://elevenlabs.io
# =============================================================================
DEEPGRAM_API_KEY=your-deepgram-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # Default: "George"
ELEVENLABS_MODEL=eleven_flash_v2_5           # Low-latency model
JARVIS_PTT_KEY=ctrl_r                        # Push-to-talk key
JARVIS_TTS=true                              # Set to false to disable spoken replies

# =============================================================================
# Authentication & Security
# =============================================================================
# JWT signing secret. In production it must be unique and at least 32 chars.
JWT_SECRET_KEY=dev-secret-change-in-production
AUTH_COOKIE_NAME=jarvis_access
REFRESH_COOKIE_NAME=jarvis_refresh
# Require HTTPS-only cookies in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=example.com
# Require developer TOTP MFA in production.
DEVELOPER_MFA_REQUIRED=false

# Developer account (created on first run if not exists). In production the
# password must not be the default and must be at least 12 characters.
DEVELOPER_EMAIL=admin@localhost
DEVELOPER_PASSWORD=changeme123

# =============================================================================
# Database Paths
# =============================================================================
# Data directory (default: ~/.jarvis)
JARVIS_DATA_DIR=~/.jarvis

# Tenant database directory
TENANT_DB_DIR=~/.jarvis/tenants

# Tenant database template SQL file
TENANT_DB_TEMPLATE=./templates/standard_bar.sql

# Tenant registry file
TENANT_REGISTRY_PATH=~/.jarvis/tenants.json

# Admin DB credentials (for provisioning only, never used in client path)
ADMIN_DB_USER=seline_admin
ADMIN_DB_PASSWORD=your-admin-db-password

# =============================================================================
# Memory Settings
# =============================================================================
JARVIS_MEMORY_MAX_CONTEXT=2000
JARVIS_MAX_CONVERSATION_TURNS=80

# =============================================================================
# Tool Settings
# =============================================================================
JARVIS_TOOL_TIMEOUT=30
JARVIS_TOOL_MAX_OUTPUT=4000
JARVIS_TURN_TIMEOUT=120
